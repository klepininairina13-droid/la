<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>Мими-Таблица Шульте</title>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800;900&display=swap" rel="stylesheet">
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; user-select: none; }
  html, body { width: 100%; height: 100%; height: 100dvh; overflow: hidden; font-family: 'Montserrat', sans-serif; background: #F5EDE3; position: fixed; }

  .bg-blobs { position: absolute; inset: 0; overflow: hidden; z-index: 0; }
  .blob { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.5; animation: float 10s ease-in-out infinite; }
  .blob-1 { width: 350px; height: 350px; background: #E8DCC4; top: -80px; left: -80px; }
  .blob-2 { width: 300px; height: 300px; background: #D4E7D4; bottom: -80px; right: -80px; animation-delay: -3s; }
  .blob-3 { width: 250px; height: 250px; background: #F0D9E8; top: 40%; left: 60%; animation-delay: -6s; }
  @keyframes float { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(30px, -30px) scale(1.15); } }

  .app { position: relative; z-index: 1; max-width: 560px; margin: 0 auto; height: 100%; display: flex; flex-direction: column; padding: 20px; padding-top: calc(20px + env(safe-area-inset-top)); }

  .screen { display: none; flex-direction: column; align-items: center; justify-content: center; flex: 1; width: 100%; animation: fadeIn 0.5s ease; }
  .screen.active { display: flex; }
  @keyframes fadeIn { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: scale(1); } }

  /* ===== ГЛАВНЫЙ ЭКРАН С ВИДЕО НА ВЕСЬ ЭКРАН ===== */
  #screen-menu { padding: 0; justify-content: flex-end; align-items: center; position: relative; overflow: hidden; }
  
  .fullscreen-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }
  .fullscreen-video video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  
  .video-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(245, 237, 227, 0.3) 0%, rgba(245, 237, 227, 0.1) 40%, rgba(139, 115, 85, 0.4) 100%);
    z-index: 1;
    pointer-events: none;
  }
  
  .menu-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding: 0 30px;
    padding-bottom: calc(60px + env(safe-area-inset-bottom));
  }
  
  .title { font-size: 44px; font-weight: 900; color: #fff; text-align: center; margin-bottom: 30px; letter-spacing: -1px; text-shadow: 0 4px 20px rgba(139, 115, 85, 0.6); }

  .cashmere-btn {
    background: linear-gradient(135deg, rgba(212, 197, 176, 0.7) 0%, rgba(228, 213, 192, 0.7) 100%);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 2px solid rgba(255, 255, 255, 0.9);
    border-radius: 60px;
    padding: 22px 70px;
    font-size: 24px; font-weight: 800; font-family: 'Montserrat', sans-serif; color: #6B5A45;
    box-shadow: 0 12px 35px rgba(139, 115, 85, 0.3), inset 0 3px 15px rgba(255,255,255,0.95), inset 0 -3px 10px rgba(139, 115, 85, 0.1);
    cursor: pointer; transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative; overflow: hidden;
  }
  .cashmere-btn::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 50%; background: linear-gradient(180deg, rgba(255,255,255,0.7) 0%, rgba(255,255,255,0) 100%); border-radius: 58px 58px 0 0; pointer-events: none; }
  .cashmere-btn:active { transform: scale(0.9); box-shadow: 0 6px 20px rgba(139, 115, 85, 0.2), inset 0 3px 10px rgba(255,255,255,0.8); }

  .header { display: flex; justify-content: space-between; align-items: center; width: 100%; margin-bottom: 15px; }
  .cashmere-pill { 
    background: linear-gradient(135deg, rgba(212, 197, 176, 0.5) 0%, rgba(228, 213, 192, 0.5) 100%);
    backdrop-filter: blur(15px); border: 1.5px solid rgba(255,255,255,0.8); 
    border-radius: 40px; padding: 12px 24px; font-size: 18px; font-weight: 800; color: #6B5A45; 
    box-shadow: 0 6px 20px rgba(139, 115, 85, 0.15), inset 0 2px 10px rgba(255,255,255,0.9);
  }

  .game-zone { flex: 1; display: flex; align-items: center; justify-content: center; width: 100%; position: relative; }
  
  .grid { display: grid; gap: 10px; width: 100%; max-width: 420px; padding: 12px; }
  
  .cell {
    aspect-ratio: 1;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, rgba(212, 197, 176, 0.4) 0%, rgba(228, 213, 192, 0.4) 100%);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border: 2px solid rgba(255, 255, 255, 0.95);
    border-radius: 24px;
    font-size: 34px; font-weight: 900; font-family: 'Montserrat', sans-serif;
    box-shadow: 0 8px 20px rgba(139, 115, 85, 0.12), inset 0 3px 12px rgba(255,255,255,0.95), inset 0 -3px 8px rgba(139, 115, 85, 0.08);
    cursor: pointer; transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative; overflow: hidden;
  }
  .cell::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 45%; background: linear-gradient(180deg, rgba(255,255,255,0.85) 0%, rgba(255,255,255,0) 100%); border-radius: 22px 22px 0 0; pointer-events: none; }
  .cell:active { transform: scale(0.88); }
  
  .cell.correct {
    color: #fff !important;
    border-color: rgba(255,255,255,0.6);
    box-shadow: 0 0 20px rgba(0,0,0,0.2), inset 0 2px 8px rgba(255,255,255,0.3);
    animation: pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes pop { 0% { transform: scale(1); } 40% { transform: scale(1.18); } 100% { transform: scale(1); } }

  .cell.wrong { animation: wiggle 0.5s ease; background: linear-gradient(135deg, rgba(255, 195, 208, 0.7) 0%, rgba(255, 210, 220, 0.7) 100%); }
  @keyframes wiggle { 0%, 100% { transform: rotate(0deg); } 25% { transform: rotate(-10deg); } 75% { transform: rotate(10deg); } }

  .hint-bubble {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    font-size: 100px; font-weight: 900; color: rgba(139, 115, 85, 0.1);
    pointer-events: none; z-index: 0;
  }

  .result-box { 
    background: linear-gradient(135deg, rgba(212, 197, 176, 0.5) 0%, rgba(228, 213, 192, 0.5) 100%);
    backdrop-filter: blur(25px); border: 2px solid rgba(255,255,255,0.9); 
    border-radius: 50px; padding: 50px 40px; text-align: center; 
    box-shadow: 0 25px 60px rgba(139, 115, 85, 0.2), inset 0 3px 15px rgba(255,255,255,0.95); 
    width: 100%; max-width: 340px;
    position: relative; overflow: hidden;
  }
  .result-box::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 50%; background: linear-gradient(180deg, rgba(255,255,255,0.6) 0%, rgba(255,255,255,0) 100%); border-radius: 48px 48px 0 0; pointer-events: none; }
  .result-title { font-size: 34px; font-weight: 900; color: #8B7355; margin-bottom: 25px; position: relative; z-index: 1; }
  .result-stats { display: flex; justify-content: space-around; margin-bottom: 35px; position: relative; z-index: 1; }
  .stat-val { font-size: 32px; font-weight: 900; color: #D4A5A5; }
  .stat-lbl { font-size: 12px; font-weight: 800; color: #A89880; text-transform: uppercase; letter-spacing: 1px; }

</style>
</head>
<body>

<div class="bg-blobs">
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>
  <div class="blob blob-3"></div>
</div>

<div class="app">
  <!-- ГЛАВНЫЙ ЭКРАН С ВИДЕО -->
  <div class="screen active" id="screen-menu">
    <div class="fullscreen-video">
      <video src="intro.mp4" autoplay loop muted playsinline></video>
    </div>
    <div class="video-overlay"></div>
    <div class="menu-content">
      <div class="title">Таблица Шульте</div>
      <button class="cashmere-btn" onclick="startGame()">Начать</button>
    </div>
  </div>

  <div class="screen" id="screen-game">
    <div class="header">
      <div class="cashmere-pill" id="timer">00:00</div>
      <div class="cashmere-pill" id="level-badge">5x5</div>
    </div>
    <div class="game-zone">
      <div class="hint-bubble" id="hint">1</div>
      <div class="grid" id="grid"></div>
    </div>
    <div class="header" style="margin-top: 15px; margin-bottom: 0; justify-content: center;">
      <div class="cashmere-pill" id="errors">Ошибки: 0</div>
    </div>
  </div>

  <div class="screen" id="screen-result">
    <div class="result-box">
      <div class="result-title">Молодец!</div>
      <div class="result-stats">
        <div><div class="stat-val" id="res-time">0с</div><div class="stat-lbl">Время</div></div>
        <div><div class="stat-val" id="res-errors">0</div><div class="stat-lbl">Ошибки</div></div>
      </div>
      <button class="cashmere-btn" onclick="nextLevel()" style="padding: 18px 50px; font-size: 22px;">Дальше</button>
    </div>
  </div>
</div>

<script>
  let gridSize = 5;
  let currentNum = 1;
  let totalNums = 25;
  let errors = 0;
  let startTime = 0;
  let timerInterval = null;

  const digitColors = [
    '#FF6B8A', '#4ECDC4', '#A78BFA', '#FBBF24', '#34D399',
    '#F472B6', '#60A5FA', '#FB923C', '#A3E635', '#C084FC',
    '#2DD4BF', '#F87171', '#FACC15', '#818CF8', '#22D3EE'
  ];

  const correctColors = [
    '#1a6b4a', '#8b2e5f', '#3d5a99', '#6b3a7d', '#c45c2e',
    '#2d7d7d', '#9b4d6b', '#4a6b3a', '#7a3d8b', '#b84a2a',
    '#2a5a7a', '#6b4a2a', '#5a2a6b', '#3a6b5a', '#8b4a3a'
  ];

  function showScreen(id) {
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    document.getElementById(id).classList.add('active');
  }

  function shuffle(arr) {
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }

  function startGame() {
    currentNum = 1;
    errors = 0;
    totalNums = gridSize * gridSize;
    document.getElementById('errors').textContent = `Ошибки: 0`;
    document.getElementById('level-badge').textContent = `${gridSize}x${gridSize}`;
    
    buildGrid();
    showScreen('screen-game');
    
    startTime = Date.now();
    clearInterval(timerInterval);
    timerInterval = setInterval(() => {
      const sec = Math.floor((Date.now() - startTime) / 1000);
      const m = Math.floor(sec / 60).toString().padStart(2, '0');
      const s = (sec % 60).toString().padStart(2, '0');
      document.getElementById('timer').textContent = `${m}:${s}`;
    }, 1000);
  }

  function buildGrid() {
    const grid = document.getElementById('grid');
    grid.innerHTML = '';
    grid.style.gridTemplateColumns = `repeat(${gridSize}, 1fr)`;
    
    const nums = shuffle(Array.from({length: totalNums}, (_, i) => i + 1));
    
    const fontSize = gridSize === 5 ? 34 : gridSize === 6 ? 28 : gridSize === 7 ? 24 : 20;
    const borderRadius = gridSize === 5 ? 24 : 20;

    nums.forEach(num => {
      const cell = document.createElement('div');
      cell.className = 'cell';
      cell.textContent = num;
      cell.dataset.num = num;
      cell.style.fontSize = fontSize + 'px';
      cell.style.borderRadius = borderRadius + 'px';
      const color = digitColors[Math.floor(Math.random() * digitColors.length)];
      cell.style.color = color;
      cell.onclick = () => handleClick(cell, num);
      grid.appendChild(cell);
    });
    
    document.getElementById('hint').textContent = currentNum;
  }

  function handleClick(cell, num) {
    if (cell.classList.contains('correct')) return;
    
    if (num === currentNum) {
      cell.classList.add('correct');
      const correctColor = correctColors[Math.floor(Math.random() * correctColors.length)];
      cell.style.background = `linear-gradient(135deg, ${correctColor} 0%, ${correctColor}dd 100%)`;
      currentNum++;
      document.getElementById('hint').textContent = currentNum <= totalNums ? currentNum : '★';
      
      if (currentNum > totalNums) {
        clearInterval(timerInterval);
        setTimeout(showResult, 600);
      }
    } else {
      errors++;
      document.getElementById('errors').textContent = `Ошибки: ${errors}`;
      cell.classList.add('wrong');
      setTimeout(() => cell.classList.remove('wrong'), 500);
    }
  }

  function showResult() {
    const sec = Math.floor((Date.now() - startTime) / 1000);
    document.getElementById('res-time').textContent = sec + 'с';
    document.getElementById('res-errors').textContent = errors;
    showScreen('screen-result');
  }

  function nextLevel() {
    gridSize = gridSize >= 8 ? 5 : gridSize + 1;
    startGame();
  }
</script>
</body>
</html>
